<?xml version="1.0" encoding="utf-8"?>
<!--
    L'app non persiste dati locali: escludiamo tutti i domini dal backup
    per evitare che vengano inclusi dati non necessari.
    Usato su dispositivi con API <= 30.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
